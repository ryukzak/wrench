0:	input_addr
4:	output_addr
8:	_start
---
mem[0x00..0x03]: 	80 00 00 00	@"input_addr"
mem[0x04..0x07]: 	84 00 00 00	@"output_addr"
mem[0x08..0x0d]: 	MoveA {mode = Long, src = Immediate 0, dst = DirectAddrReg A0} 	@_start
mem[0x0e..0x11]: 	MoveA {mode = Long, src = IndirectAddrReg 0 A0 Nothing, dst = DirectAddrReg A0}
mem[0x12..0x15]: 	Move {mode = Long, src = IndirectAddrReg 0 A0 Nothing, dst = DirectDataReg D0}
mem[0x16..0x17]: 	Not {mode = Long, dst = DirectDataReg D0}
mem[0x18..0x1d]: 	Move {mode = Long, src = Immediate 1, dst = DirectDataReg D1}
mem[0x1e..0x1f]: 	And {mode = Long, src = DirectDataReg D1, dst = DirectDataReg D0}
mem[0x20..0x25]: 	MoveA {mode = Long, src = Immediate 4, dst = DirectAddrReg A1}
mem[0x26..0x29]: 	MoveA {mode = Long, src = IndirectAddrReg 0 A1 Nothing, dst = DirectAddrReg A1}
mem[0x2a..0x2d]: 	Move {mode = Long, src = DirectDataReg D0, dst = IndirectAddrReg 0 A1 Nothing}
mem[0x2e..0x2f]: 	Halt
mem[0x30..0x3e7]: 	( 00 )
---
