0:	input_addr
4:	output_addr
8:	const_1
12:	_start
---
mem[0x00..0x03]: 	80 00 00 00	@"input_addr"
mem[0x04..0x07]: 	84 00 00 00	@"output_addr"
mem[0x08..0x0b]: 	01 00 00 00	@"const_1"
mem[0x0c..0x10]: 	FetchP 0 	@_start
mem[0x11..0x11]: 	AStore
mem[0x12..0x12]: 	Fetch
mem[0x13..0x17]: 	FetchP 8
mem[0x18..0x18]: 	Xor
mem[0x19..0x1d]: 	FetchP 4
mem[0x1e..0x1e]: 	AStore
mem[0x1f..0x1f]: 	Store
mem[0x20..0x20]: 	Halt
mem[0x21..0x3e7]: 	( 00 )
---
